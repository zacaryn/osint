# Nothing here is required. The dashboard runs on public feeds with no keys.
PORT=8787

# Optional: free NASA FIRMS map key (never expires, no payment)
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=

# Optional: free OpenSky account raises anonymous rate limits
# https://opensky-network.org/
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Optional: self-hosted or alternate FxEmbed base (default is public)
# FXTWITTER_BASE_URL=https://api.fxtwitter.com
